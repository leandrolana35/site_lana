# Use PHP71
#AddHandler application/x-httpd-php71 .php


# Block WordPress xmlrpc.php requests
<Files xmlrpc.php>
order deny,allow
deny from all
allow from 122.248.245.244/32
allow from 54.217.201.243/32
allow from 54.232.116.4/32
allow from 192.0.80.0/20
allow from 192.0.96.0/20
allow from 192.0.112.0/20
allow from 195.234.108.0/22
</Files>

# Permite que imagens sejam carregadas por e-mails e páginas externas
<IfModule mod_headers.c>
  <FilesMatch "\.(jpe?g|jpg|png|gif|webp)$">
    Header always set Cross-Origin-Resource-Policy "cross-origin"
    Header always set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

Options -Indexes
RewriteEngine On

# URLs de produto antigas → catálogo correspondente
RewriteRule ^produto/.*caderno.*$    /brindes/cadernos/    [R=301,L,NC]
RewriteRule ^produto/.*caneta.*$     /brindes/canetas/     [R=301,L,NC]
RewriteRule ^produto/.*mochila.*$    /brindes/mochilas/    [R=301,L,NC]
RewriteRule ^produto/.*garrafa.*$    /brindes/garrafas/    [R=301,L,NC]
RewriteRule ^produto/.*bolsa.*$      /brindes/garrafas/    [R=301,L,NC]
RewriteRule ^produto/.*bloco.*$      /brindes/cadernos/    [R=301,L,NC]
RewriteRule ^produto/(.*)$           /brindes/catalogo/    [R=301,L,NC]

# Catálogo antigo → novo catálogo
RewriteRule ^home/catalogo\.html.*$  /brindes/catalogo/    [R=301,L]
RewriteRule ^catalogo\.html.*$       /brindes/catalogo/    [R=301,L]
RewriteRule ^catalogo/?$             /brindes/catalogo/    [R=301,L]

# Páginas antigas sem equivalente → hub de brindes
RewriteRule ^loja/?$                 /brindes/             [R=301,L]
RewriteRule ^servicos/?$             /brindes/             [R=301,L]
RewriteRule ^portfolio/?$            /brindes/             [R=301,L]
RewriteRule ^sobre/?$                /                     [R=301,L]
RewriteRule ^contato/?$              /                     [R=301,L]
