# ── Security Headers ──────────────────────────────────────────────────────────

<IfModule mod_headers.c>
  # Impede clickjacking (embedding em iframes de outros domínios)
  Header always set X-Frame-Options "SAMEORIGIN"

  # Impede sniffing de MIME type
  Header always set X-Content-Type-Options "nosniff"

  # Força HTTPS por 1 ano (incluindo subdomínios)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Controla informações de referrer enviadas a terceiros
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions Policy: desativa câmera, microfone, geolocalização
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # CSP básico: permite recursos próprios + Google Fonts + WhatsApp
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://llana.com.br https://unitybrindes.com.br; connect-src 'self' https://www.google-analytics.com; frame-ancestors 'self'"
</IfModule>

# ── Redirecionamentos 301 — URLs antigas para estrutura atual ──────────────────

Options -Indexes
RewriteEngine On

# URLs de produto antigas → catálogo correspondente
RewriteRule ^produto/.*caderno.*$    /brindes/cadernos/    [R=301,L,NC]
RewriteRule ^produto/.*caneta.*$     /brindes/canetas/     [R=301,L,NC]
RewriteRule ^produto/.*mochila.*$    /brindes/mochilas/    [R=301,L,NC]
RewriteRule ^produto/.*garrafa.*$    /brindes/garrafas/    [R=301,L,NC]
RewriteRule ^produto/.*bolsa.*$      /brindes/garrafas/    [R=301,L,NC]
RewriteRule ^produto/.*bloco.*$      /brindes/cadernos/    [R=301,L,NC]
RewriteRule ^produto/(.*)$           /brindes/catalogo/    [R=301,L,NC]

# Catálogo antigo → novo catálogo
RewriteRule ^home/catalogo\.html.*$  /brindes/catalogo/    [R=301,L]
RewriteRule ^catalogo\.html.*$       /brindes/catalogo/    [R=301,L]
RewriteRule ^catalogo/?$             /brindes/catalogo/    [R=301,L]

# Páginas antigas sem equivalente → hub de brindes
RewriteRule ^loja/?$                 /brindes/             [R=301,L]
RewriteRule ^servicos/?$             /brindes/             [R=301,L]
RewriteRule ^portfolio/?$            /brindes/             [R=301,L]
RewriteRule ^sobre/?$                /                     [R=301,L]
RewriteRule ^contato/?$              /                     [R=301,L]
